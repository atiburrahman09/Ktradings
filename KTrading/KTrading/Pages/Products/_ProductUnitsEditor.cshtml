@model List<KTrading.Models.ProductUnit>

<hr />
<h5>Units</h5>
<p class="text-muted">Optional for old products. Stock is stored in the base unit. Example: Piece = 1, Box = 12, Carton = 144.</p>
<div class="table-responsive">
    <table class="table table-sm" id="productUnitsTable">
        <thead><tr><th>Unit</th><th>Factor</th><th>Sell price</th><th>Cost</th><th>SKU/barcode</th><th>Base</th><th></th></tr></thead>
        <tbody>
        @for (var i = 0; i < Model.Count; i++)
        {
            <tr>
                <input type="hidden" name="Units[@i].Id" value="@Model[i].Id" />
                <td><input name="Units[@i].Name" value="@Model[i].Name" class="form-control" /></td>
                <td><input name="Units[@i].ConversionFactor" value="@Model[i].ConversionFactor" type="number" min="0.0001" step="0.0001" class="form-control factor" /></td>
                <td><input name="Units[@i].SellingPrice" value="@Model[i].SellingPrice" type="number" min="0" step="0.0001" class="form-control" /></td>
                <td><input name="Units[@i].PurchaseCost" value="@Model[i].PurchaseCost" type="number" min="0" step="0.0001" class="form-control" /></td>
                <td><input name="Units[@i].SKU" value="@Model[i].SKU" class="form-control" /></td>
                <td class="text-center"><input name="Units[@i].IsBaseUnit" value="true" type="radio" class="form-check-input base-unit" checked="@(Model[i].IsBaseUnit ? "checked" : null)" /></td>
                <td><button type="button" class="btn btn-sm btn-danger remove-unit">Remove</button></td>
            </tr>
        }
        </tbody>
    </table>
</div>
<button type="button" id="addProductUnit" class="btn btn-outline-secondary btn-sm mb-3">Add unit</button>
